# Caddy terminates HTTPS (automatic Let's Encrypt certificate for $DOMAIN) and
# proxies to the app. WebSocket upgrades (Socket.IO) pass through automatically.
{
	# Clients connecting by IP address (LAN testing) send no hostname, so serve
	# the $DOMAIN certificate by default. Harmless when DOMAIN is a real hostname.
	default_sni {$DOMAIN}

	# If another proxy/load balancer sits in front of Caddy on a private
	# network, trust its X-Forwarded-For so the app (rate limits, login
	# lockout) sees real client IPs. Public addresses are never trusted.
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode gzip zstd
	reverse_proxy web:8000
}
