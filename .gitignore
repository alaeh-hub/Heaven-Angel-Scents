# Local configuration and secrets
.env
.env.*
!.env.example
rclone.conf

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]

# Local runtime data
*.log
*.db
*.sqlite
*.sqlite3
instance/

# Local test artifacts
test_logo.pdf

# Uploaded product images stay local and are not committed
static/uploads/

# Partner portal front end (public-site/): dependencies, and the build
# Flask serves — rebuilt on every deploy, see docs/DEPLOY.md
public-site/node_modules/
static/public-site/

# Local tooling and test output
.pytest_cache/
.coverage
htmlcov/
check/

# Local design/media drafts
static/img/background*.png
static/img/background*.mp4
static/video/white_background*.mp4

# IDE and local tool metadata
.vscode/
.idea/
.agents/
.claude/
.mcp.json
skills-lock.json

# Local media assets and generated files
static/video/*.mp4
# ...except the web-sized clips the public site plays, so a fresh clone
# (see docs/DEPLOY.md) serves them. Keep these small: re-encode, don't swap
# in a raw export.
!static/video/behind-the-scent.mp4
!static/video/black_background_web.mp4

# Reference-only prototype experiments and standalone scene demos
public-site/prototype/

# Mascot source art (keyed sheets, original drawings, prompts). Only the
# built atlases in static/mascots/ are needed to run the app; rebuild them
# from here with the page-mascot skill's scripts/mascot.py.
characters/

# Full-size product renders (~7 MB each: box + bottle on a backdrop). The web
# layers in static/img/scents/ are cut from these with
# scripts/build_scent_images.py; only those are needed to run the app.
assets/scent-renders/

# Local database backup archives and restore safety copies (never commit)
backups/

# Generated local test output
*.pdf
!docs/*.pdf
coverage.xml
