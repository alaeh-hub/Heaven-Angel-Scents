SECRET_KEY=change-this-to-a-random-string
APP_ENV=development
FLASK_DEBUG=0

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=heaven_and_angel_scents

# AI Assistant — get a key from https://aistudio.google.com/apikey
# Leave blank to disable the assistant; it will tell users it isn't configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Per-user rate limit for the AI chat endpoint. Flask-Limiter syntax;
# separate multiple windows with a semicolon.
AI_CHAT_RATE_LIMIT=15 per minute;150 per day


# Storage backend for Flask-Limiter's counters. The default in-memory
# store only works correctly with a single worker process — if you run
# multiple Waitress/gunicorn workers in production, point this at a
# shared store instead, e.g.:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
