SECRET_KEY=change-this-to-a-random-string
APP_ENV=development
FLASK_DEBUG=0

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=heaven_and_angel_scents

# AI Assistant — get a key from https://aistudio.google.com/apikey
# Leave blank to disable the assistant; it will tell users it isn't configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Per-user rate limit for the AI chat endpoint. Flask-Limiter syntax;
# separate multiple windows with a semicolon.
AI_CHAT_RATE_LIMIT=15 per minute;150 per day

# Partner Portal — the private, unauthenticated link shared directly with
# distributors/resellers (never linked from the login page or anywhere in
# the signed-in app). Its only protection is this slug, so:
#   - Generate a long, random value for production:
#       python -c "import secrets; print(secrets.token_urlsafe(16))"
#   - Set it here so the link stays stable across restarts and is the
#     same on every worker process.
#   - Leave blank for local dev only — app.py will auto-generate a
#     temporary one and log it, but it changes every restart and differs
#     per worker, so it must never be left unset in production.
# Full link once set: https://yourdomain.com/partner-portal/<slug>/packages
PARTNER_PORTAL_SLUG=

# Contact details shown on the partner portal. All optional: anything
# left blank is hidden rather than shown as a placeholder.
#   PORTAL_CONTACT_VIBER   the Viber number (digits, with country code, e.g. 639171234567)
#   PORTAL_CONTACT_MESSENGER_URL   e.g. https://m.me/yourpage
#   PORTAL_REPLY_TIME      completes "We reply ...", e.g. within 1 business day
PORTAL_CONTACT_PHONE=
PORTAL_CONTACT_EMAIL=
PORTAL_CONTACT_VIBER=
PORTAL_CONTACT_MESSENGER_URL=
PORTAL_REPLY_TIME=

# Outbound mail (SMTP) — used only to notify HQ when someone submits a
# package inquiry from the public partner portal. No API needed, this is
# plain SMTP. Leave all of these blank to disable email entirely — the
# inquiry is still saved and shows up on Partner Inquiries either way,
# nothing is lost, you just won't get an email about it.
#
# To send through a Gmail account specifically:
#   1. Turn on 2-Step Verification on that Google Account.
#   2. Google Account -> Security -> 2-Step Verification -> App passwords
#      -> generate one (16 characters). Gmail rejects normal SMTP login
#      with your regular password once 2FA is on — use the app password
#      below instead, not your real Gmail password.
#   3. MAIL_USERNAME / MAIL_DEFAULT_SENDER is the Gmail address sending
#      the email. PARTNER_INQUIRY_NOTIFY_EMAIL is the inbox that should
#      receive new-lead notifications — it can be that same Gmail address
#      or a different one entirely.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
PARTNER_INQUIRY_NOTIFY_EMAIL=

# Development only: shows Admin > Clear Data (wipes all business records).
# Never set this on a real deployment (it is forced off when APP_ENV=production).
ALLOW_DATA_RESET=0

# --- Docker deployment (docker-compose.yml) -- see DOCKER_DEPLOY.md ---
# Compose overrides MYSQL_HOST/USER/PASSWORD for the web container, so the
# MYSQL_* values above only matter for running outside Docker.
# Public domain Caddy serves (its A record must point at the server):
DOMAIN=
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_ROOT_PASSWORD=
DB_APP_USER=heaven_app
DB_APP_PASSWORD=
BACKUP_RETENTION_DAYS=14
